# syntax=docker/dockerfile:1.7

# Build stage: compile a static kb binary.
FROM golang:1.26-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY cmd/kb ./cmd/kb
COPY internal ./internal

# CGO disabled so the binary is fully static and runs on distroless/static.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build \
        -trimpath \
        -ldflags="-s -w" \
        -o /out/kb ./cmd/kb

# Runtime stage: distroless/static ships ca-certificates (HTTPS to the embedding
# provider), tzdata and a nonroot passwd entry, and nothing else - no shell,
# no package manager.
FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /out/kb /usr/local/bin/kb

# Streamable HTTP default from `kb serve-mcp -http-addr :8081`.
EXPOSE 8081

USER nonroot:nonroot

# Required env: DATABASE_URL; OPENROUTER_API_KEY (provider openrouter) or
# GOOGLE_API_KEY / GEMINI_API_KEY (provider google).
ENTRYPOINT ["/usr/local/bin/kb"]
CMD ["serve-mcp", "-transport", "http", "-http-addr", ":8081", "-http-path", "/mcp"]
