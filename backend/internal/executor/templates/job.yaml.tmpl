---
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ quote .JobName }}
  namespace: {{ quote .Namespace }}
  labels:
    app.kubernetes.io/name: {{ quote .JobName }}
    app.kubernetes.io/component: job
    app.kubernetes.io/part-of: {{ quote .Namespace }}
    devops-ai/task-type: {{ quote .TaskTypeLabel }}
    devops-ai/thread-root: {{ quote .ThreadRootLabel }}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 1800
  ttlSecondsAfterFinished: {{ .JobTTLSeconds }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ quote .JobName }}
        app.kubernetes.io/component: job
        app.kubernetes.io/part-of: {{ quote .Namespace }}
      annotations:
        nib-ai/task-id: {{ quote .TaskID }}
    spec:
      restartPolicy: Never
      automountServiceAccountToken: true
      serviceAccountName: {{ quote .ServiceAccount }}
      serviceAccount: {{ quote .ServiceAccount }}
      securityContext:
        fsGroup: 1000
        runAsGroup: 1000
        runAsNonRoot: true
        runAsUser: 1000
      containers:
        - name: agent
          image: {{ quote .AgentImage }}
          imagePullPolicy: Always
          env:
            - name: PROMPT
              value: {{ quote .Prompt }}
            - name: REPO_URL
              value: {{ quote .RepoURL }}
            {{- if .BaseBranch }}
            - name: BASE_BRANCH
              value: {{ quote .BaseBranch }}
            {{- end }}
            - name: TARGET_BRANCH
              value: {{ quote .TargetBranch }}
            {{- if .PRTitle }}
            - name: PR_TITLE
              value: {{ quote .PRTitle }}
            {{- end }}
            - name: MCP_CONFIG_FILE
              value: "/config/mcp.json"
            - name: ALLOWED_TOOLS
              value: {{ quote .AllowedTools }}
            - name: PERMISSION_MODE
              value: "acceptEdits"
            - name: TIMEOUT_SECONDS
              value: "1500"
            {{- if .GitAuthorName }}
            - name: GIT_AUTHOR_NAME
              value: {{ quote .GitAuthorName }}
            {{- end }}
            {{- if .GitAuthorEmail }}
            - name: GIT_AUTHOR_EMAIL
              value: {{ quote .GitAuthorEmail }}
            {{- end }}
            - name: JOB_NAME
              value: {{ quote .JobName }}
            - name: CHAT_ID
              value: {{ quote .ChatID }}
            - name: TASK_ID
              value: {{ quote .TaskID }}
            - name: AGENT_TYPE
              value: {{ quote .AgentType }}
            - name: GIT_PROVIDER
              value: {{ quote .GitProvider }}
            {{- if .WebhookURL }}
            - name: WEBHOOK_URL
              value: {{ quote .WebhookURL }}
            {{- end }}
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            {{- if .AnthropicModel }}
            - name: ANTHROPIC_MODEL
              value: {{ quote .AnthropicModel }}
            {{- end }}
            {{- if .AnthropicBaseURL }}
            - name: ANTHROPIC_BASE_URL
              value: {{ quote .AnthropicBaseURL }}
            {{- end }}
            {{- if .OpenAIModel }}
            - name: OPENAI_MODEL
              value: {{ quote .OpenAIModel }}
            {{- end }}
            {{- if .OpenAIBaseURL }}
            - name: OPENAI_BASE_URL
              value: {{ quote .OpenAIBaseURL }}
            {{- end }}
          envFrom:
            - secretRef:
                name: {{ quote .AgentSecret }}
                optional: false
          resources:
            limits:
              cpu: {{ quote .AgentLimitCPU }}
              ephemeral-storage: 10Gi
              memory: {{ quote .AgentLimitMemory }}
            requests:
              cpu: {{ quote .AgentRequestCPU }}
              ephemeral-storage: 10Gi
              memory: {{ quote .AgentRequestMemory }}
          volumeMounts:
            - name: workspace
              mountPath: /workspace
            - name: config
              mountPath: /config
              readOnly: true
      volumes:
        - name: workspace
          emptyDir: {}
        - name: config
          configMap:
            name: {{ quote .AgentMCPConfig }}
            optional: true
