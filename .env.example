# `make setup` fills this in interactively and starts the stack. By hand:
# Copy to .env and adjust values before starting Nib:
#   cp .env.example .env
#   # set LLM_API_KEY (required)
#   docker compose up -d
#
# Development (live reload, source mounts):
#   docker compose -f docker-compose.dev.yml up

# -----------------------------------------------------------------------------
# Image versions (production docker-compose.yml)
# Match tags published from the root VERSION file (all three images share the tag).
# -----------------------------------------------------------------------------
NIB_VERSION=v0.8.1
NIB_KB_VERSION=v0.8.1

# config.yaml mounted into the backend. `make setup` writes and selects
# ./deploy/compose/config.local.yaml; unset uses the tracked example.
# NIB_CONFIG_FILE=./deploy/compose/config.yaml

# Host port for the web UI (nginx serves the SPA and proxies /api to the backend).
NIB_HTTP_PORT=8080

# Optional host port for direct backend API access (debugging, OAuth without the SPA proxy).
NIB_BACKEND_PORT=8081

# Host port for the Prometheus metrics listener. /metrics is unauthenticated and
# leaks topology (plan counts, model id, cumulative LLM cost), so publish it to
# the host only when something on the host needs to scrape it.
NIB_METRICS_PORT=9090

# Metrics settings otherwise come from config.yaml; these env vars override it.
# METRICS_ENABLED=true
# METRICS_PATH=/metrics
# METRICS_REFRESH_SECONDS=30

# -----------------------------------------------------------------------------
# PostgreSQL (bundled postgres service)
# -----------------------------------------------------------------------------
POSTGRES_USER=nib
POSTGRES_PASSWORD=nib
POSTGRES_DB=nib

# -----------------------------------------------------------------------------
# LLM provider (required for chat and knowledge-base embeddings)
# Set at least one of LLM_API_KEY or OPENAI_API_KEY.
# -----------------------------------------------------------------------------
LLM_API_KEY=
OPENAI_API_KEY=

# Optional LLM overrides (defaults come from deploy/compose/config.yaml).
# LLM_API=responses
# LLM_REASONING_EFFORT=medium
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embeddings endpoint for the backend, when it is not the completion host.
# DeepSeek, xAI and Moonshot serve chat completions and no /embeddings route,
# so pointing llm.baseURL at one of them needs these set. Each falls back to
# the matching LLM_* value, so leave them empty for a single-provider install.
# See docs/how-to/switch-llm-provider.md#provider-presets.
# LLM_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# LLM_EMBEDDINGS_API_KEY=
# LLM_EMBEDDINGS_MODEL=text-embedding-3-small
# Width to request. Required for a model that is not natively 1536 wide
# (Gemini is 3072, Qwen is 1024); kb_chunks.embedding is vector(1536).
# LLM_EMBEDDINGS_DIMENSIONS=1536

# OpenAI-compatible embeddings endpoint for the kb-mcp service.
#
# This is the *query* side of the same knowledge base the backend ingests into,
# so it must agree with the LLM_EMBEDDINGS_* settings above on both model and
# width -- a mismatch returns no search results and reports no error.
KB_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# KB_EMBEDDINGS_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# API authentication (required)
# Every /api/v1 route except /health, /version and the agent-runner webhook
# needs this token: the web UI asks for it once and keeps an HttpOnly session
# cookie, scripts send "Authorization: Bearer <token>". At least 32 characters:
#   openssl rand -hex 32
# The backend refuses to start without it unless NIB_INSECURE_NO_AUTH=true,
# which leaves the API open to anyone who can reach the port.
# -----------------------------------------------------------------------------
NIB_API_TOKEN=
# NIB_INSECURE_NO_AUTH=true
# Extra origins allowed to make cross-origin writes (comma-separated,
# scheme://host[:port]). Default: http://localhost:5173 (the Vite dev server).
# NIB_ALLOWED_ORIGINS=
# Host headers the API answers to (comma-separated, host or host:port). Empty
# serves any host; set it to block DNS rebinding, above all without a token.
# NIB_ALLOWED_HOSTS=nib.example.com,localhost

# -----------------------------------------------------------------------------
# Application secrets
# Generate a 32-byte key (base64) to enable encrypted Variables → Secrets storage:
#   openssl rand -base64 32
# Leave empty to run without secret write support (read-only for existing secrets).
# -----------------------------------------------------------------------------
SECRETS_ENCRYPTION_KEY=

# Shown in the UI and returned by GET /api/v1/version.
APP_VERSION=v0.8.1

# -----------------------------------------------------------------------------
# Executor / agent-runner (optional — local Docker executor)
# Required only when using run_executor with the local executor profile.
# The git API token is NOT here: it is selected by name in Settings -> Executor
# and read from the encrypted secret store (Variables -> Secrets).
# -----------------------------------------------------------------------------
EXECUTOR_LLM_API_KEY=
EXECUTOR_LLM_MODEL=
# Optional key the backend signs each runner container's webhook token with.
# Containers only ever get a token for their own run, never this key. Empty
# generates one into {DATA_DIR}/.webhook-key.
AGENT_WEBHOOK_TOKEN=

# -----------------------------------------------------------------------------
# Development compose only (docker-compose.dev.yml)
# -----------------------------------------------------------------------------
# API_PROXY_TARGET=http://backend:8080
